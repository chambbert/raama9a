generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  generatedPassword String?  // plaintext stored for admin visibility
  name              String
  phone             String?
  role              String   @default("CLIENT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visits        Visit[]
  cleanerVisits Visit[] @relation("CleanerVisits")
  reviews       Review[]
}

model Apartment {
  id          String   @id @default(cuid())
  name        String
  address     String
  description String?
  latitude    Float?
  longitude   Float?
  cleanerFee  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits         Visit[]
  keyCodes       KeyCode[]
  cleaningTasks  CleaningTask[]
  pricing        ApartmentPricing[]
  datePrices     ApartmentDatePrice[]
  bookings       Booking[]
}

model Visit {
  id          String    @id @default(cuid())
  userId      String
  apartmentId String
  cleanerId   String?
  checkIn     DateTime
  checkOut    DateTime?
  revenue     Float     @default(0)
  costs       Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  cleaner     User?     @relation("CleanerVisits", fields: [cleanerId], references: [id], onDelete: SetNull)
  lineItems       VisitLineItem[]
  taskCompletions TaskCompletion[]
  incidentReports IncidentReport[]
}

model VisitLineItem {
  id          String   @id @default(cuid())
  visitId     String
  type        String   // 'revenue' or 'cost'
  description String
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model KeyCode {
  id          String    @id @default(cuid())
  apartmentId String
  code        String
  description String
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model Instruction {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sightseeing {
  id          String   @id @default(cuid())
  name        String
  description String
  address     String?
  category    String
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model HeroImage {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id           String  @id @default(cuid())
  siteName     String  @default("Welcome to Our Apartment")
  contactEmail String?
  contactPhone String?
  address      String?
  mapUrl       String?
}

model CleaningTask {
  id          String        @id @default(cuid())
  apartmentId String
  apartment   Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completions TaskCompletion[]
}

model TaskCompletion {
  id          String       @id @default(cuid())
  taskId      String
  task        CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  visitId     String
  visit       Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  completedAt DateTime     @default(now())
  mediaUrls   String?      // JSON array of file URL strings

  @@unique([taskId, visitId])
}

model IncidentReport {
  id          String    @id @default(cuid())
  visitId     String
  visit       Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type        String    // 'broken' | 'stolen' | 'other'
  description String
  mediaUrls   String?   // JSON array of file URL strings
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApartmentDatePrice {
  id          String    @id @default(cuid())
  apartmentId String
  date        String    // YYYY-MM-DD
  price       Float
  updatedAt   DateTime  @updatedAt

  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, date])
}

model ApartmentPricing {
  id            String    @id @default(cuid())
  apartmentId   String
  dayOfWeek     Int       // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  pricePerNight Float     @default(0)
  updatedAt     DateTime  @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, dayOfWeek])
}

model Booking {
  id             String    @id @default(cuid())
  apartmentId    String
  guestName      String
  guestEmail     String
  guestPhone     String?
  checkIn        DateTime
  checkOut       DateTime
  adults         Int       @default(1)
  notes          String?
  status         String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  adminNotes     String?
  totalPrice     Float     @default(0)
  cleanerFee     Float     @default(0)
  priceBreakdown String?   // JSON array of {date, dayOfWeek, price}
  visitors       String?   // JSON array of {name, birthdate}
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}
